     absl::BitGenRef random) {
diff --git a/ortools/sat/cp_model_lns.h b/ortools/sat/cp_model_lns.h
index 911c8c1..956b423 100644
--- a/ortools/sat/cp_model_lns.h
+++ b/ortools/sat/cp_model_lns.h
@@ -557,6 +557,55 @@ class RelaxRandomVariablesGenerator : public NeighborhoodGenerator {
                         SolveData& data, absl::BitGenRef random) final;
 };
 
+// Relaxes every placement variable belonging to a small number of whole
+// "division-days" (one class's one day of the week), and fixes the rest.
+//
+// Motivation: every generic generator in this file picks its fragment either
+// at random (above) or by walking the variable/constraint graph (below).
+// Neither can know that a university timetable decomposes naturally into
+// division-days. That matters because nearly every soft cost the timetable
+// objective pays -- idle gaps, day span, break placement -- is computed
+// *within* a single division-day. Relaxing one whole division-day therefore
+// hands the sub-solver a fragment whose internal structure it can actually
+// improve, instead of a scattering of unrelated placements that leaves every
+// gap penalty pinned by the frozen variables around it.
+//
+// `groups` is built by GroupVariablesByDomainTag(model, "@G=") -- see
+// cp_model_utils.h for how the grouping survives presolve.
+class DivisionDayNeighborhoodGenerator : public NeighborhoodGenerator {
+ public:
+  DivisionDayNeighborhoodGenerator(NeighborhoodGeneratorHelper const* helper,
+                                   absl::string_view name,
+                                   std::vector<std::vector<int>> groups);
+
+  Neighborhood Generate(const CpSolverResponse& initial_solution,
+                        SolveData& data, absl::BitGenRef random) final;
+
+  // A model with no "@G=" tags (i.e. one that did not come from the timetable
+  // builder) yields no groups; no-op rather than burn an LNS worker on it.
+  bool ReadyToGenerate() const override {
+    return !groups_.empty() && NeighborhoodGenerator::ReadyToGenerate();
+  }
+
+ private:
+  std::vector<std::vector<int>> groups_;
+
+  // Variables carrying no "@G=" tag at all: the auxiliary machinery of the
+  // model (per-day occupancy indicators, gap/span literals, workload counters)
+  // rather than placement decisions. These are *always* relaxed alongside the
+  // chosen groups.
+  //
+  // This is not an optimization, it is required for correctness of the
+  // fragment: those variables are functionally determined by the placement
+  // variables through lin_max/linear constraints, so freezing them at their
+  // incumbent values while relaxing the placements underneath them would pin
+  // the very occupancy pattern this generator is trying to change, leaving a
+  // neighborhood that is feasible but essentially unimprovable. Relaxing them
+  // costs next to nothing in search: once the frozen division-days' placements
+  // are fixed, propagation immediately re-derives them.
+  std::vector<int> always_relaxed_;
+};
