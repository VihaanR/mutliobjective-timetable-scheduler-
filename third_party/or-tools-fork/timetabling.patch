@@ -438,6 +438,36 @@ bool ConvertCpModelProtoToWCnf(const CpModelProto& cp_model, std::string* out);
 // We assume delta >= 0 and we only use the low bit of delta.
 int CombineSeed(int base_seed, int64_t delta);
 
+// --- Domain-structure tags (timetabling research fork) ----------------------
+//
+// Upstream CP-SAT has no way to represent application-level structure: nothing
+// in a CpModelProto says that two Boolean variables describe placements of the
+// *same* university course, or that a group of variables all belong to the
+// *same* division-day. That knowledge exists only in the model-building layer.
+//
+// We pass it down through the one channel that already survives presolve
+// intact -- the variable name (presolve_context.cc copies the name whenever it
+// creates a replacement variable). The timetable model emits names shaped like
+//
+//     x_<req>_<slot>_<room>@R=<requirement id>@G=<division>#<day>
+//
+// where each "@KEY=" tag runs until the next '@' or the end of the name.
+// Everything before the first '@' is free-form and ignored, so the existing
+// human-readable debug names are preserved unchanged.
+//
+// Returns an empty view when `tag` does not appear in `var_name`.
+absl::string_view ExtractDomainTag(absl::string_view var_name,
+                                   absl::string_view tag);
+
+// Buckets the variable indices of `cp_model` by the value of `tag` in their
+// name. Variables whose name lacks `tag` are skipped entirely, so a model that
+// did not come from the timetable builder simply yields no groups.
+//
+// Groups come back in first-seen order rather than hash order: LNS and search
+// must be reproducible run to run, and iteration order of a hash map is not.
+std::vector<std::vector<int>> GroupVariablesByDomainTag(
+    const CpModelProto& cp_model, absl::string_view tag);
+
 }  // namespace sat
 }  // namespace operations_research
 
