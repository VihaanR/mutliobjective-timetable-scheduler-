index a286def..dad0f23 100644
--- a/ortools/sat/cp_model.proto
+++ b/ortools/sat/cp_model.proto
@@ -542,6 +542,19 @@ message DecisionStrategyProto {
     CHOOSE_HIGHEST_MAX = 2;
     CHOOSE_MIN_DOMAIN_SIZE = 3;
     CHOOSE_MAX_DOMAIN_SIZE = 4;
+
+    // Timetabling research fork. Branch on a variable belonging to the group
+    // with the fewest still-unfixed members, where groups are read from the
+    // "@R=" tags in variable names (see cp_model_utils.h).
+    //
+    // This is the classic minimum-remaining-values heuristic, which the five
+    // strategies above cannot express for a model built out of Boolean
+    // placement flags: each such flag has domain {0, 1}, so
+    // CHOOSE_MIN_DOMAIN_SIZE scores every one of them identically (2) and
+    // degenerates to CHOOSE_FIRST. What we actually want to compare is how
+    // many placements remain open for the *course*, which is a property of a
+    // group of variables and has no representation in the proto otherwise.
+    CHOOSE_MIN_UNFIXED_IN_GROUP = 5;
   }
   VariableSelectionStrategy variable_selection_strategy = 2;
 
